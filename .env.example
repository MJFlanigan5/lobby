PORT=3000
PLEX_URL=http://192.168.1.x:32400
PLEX_TOKEN=
JELLYFIN_URL=http://192.168.1.x:8096
JELLYFIN_API_KEY=
SONARR_URL=http://192.168.1.x:8989
SONARR_API_KEY=
RADARR_URL=http://192.168.1.x:7878
RADARR_API_KEY=
GOVEE_IP=
GOVEE_DEVICE_ID=
# Home Assistant light sync — works with any light HA exposes, not just Govee
HA_URL=
HA_TOKEN=
HA_LIGHT_ENTITY_ID=
# Philips Hue — direct to bridge, no Home Assistant required
HUE_BRIDGE_IP=
HUE_USERNAME=
HUE_LIGHT_ID=
# LIFX Cloud API
LIFX_TOKEN=
LIFX_SELECTOR=
# Sonos volume ducking during theme music playback
SONOS_IP=
SONOS_DUCK_VOLUME=15
# Weather (Open-Meteo, no API key needed)
LATITUDE=
LONGITUDE=
TEMP_UNIT=fahrenheit
# Auto-schedule (day: monday/tuesday/.../weekdays/weekends/daily, hour: 0-23)
# TIMEZONE controls what hour SCHEDULE_*_HOUR actually fires at (IANA name, e.g. America/Chicago)
TIMEZONE=America/New_York
SCHEDULE_CS_DAY=
SCHEDULE_CS_HOUR=18
SCHEDULE_AUTO_DAY=
SCHEDULE_AUTO_HOUR=6
SCHEDULE_SLEEP_DAY=
SCHEDULE_SLEEP_HOUR=23
SCHEDULE_WAKE_DAY=
SCHEDULE_WAKE_HOUR=7
# Plays the Plex theme song during the Ambient/Poster library cycle (off by default)
THEME_MUSIC_ENABLED=false
