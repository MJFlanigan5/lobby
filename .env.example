PORT=3000
PLEX_URL=http://192.168.1.x:32400
PLEX_TOKEN=
JELLYFIN_URL=http://192.168.1.x:8096
JELLYFIN_API_KEY=
SONARR_URL=http://192.168.1.x:8989
SONARR_API_KEY=
RADARR_URL=http://192.168.1.x:7878
RADARR_API_KEY=
GOVEE_IP=
GOVEE_DEVICE_ID=
# Weather (Open-Meteo, no API key needed)
LATITUDE=
LONGITUDE=
TEMP_UNIT=fahrenheit
# Auto-schedule (day: monday/tuesday/.../weekdays/weekends/daily, hour: 0-23)
# TIMEZONE controls what hour SCHEDULE_*_HOUR actually fires at (IANA name, e.g. America/Chicago)
TIMEZONE=America/New_York
SCHEDULE_CS_DAY=
SCHEDULE_CS_HOUR=18
SCHEDULE_AUTO_DAY=
SCHEDULE_AUTO_HOUR=6
SCHEDULE_SLEEP_DAY=
SCHEDULE_SLEEP_HOUR=23
SCHEDULE_WAKE_DAY=
SCHEDULE_WAKE_HOUR=7
# Plays the Plex theme song for a single active Now Playing session (off by default)
THEME_MUSIC_ENABLED=false
